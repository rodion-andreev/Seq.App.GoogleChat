<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <VersionPrefix>1.1.0</VersionPrefix>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>An app for Seq that forwards events and alert notifications to Google Chat.</Description>
        <Authors>rodion-andreev</Authors>
        <PackageTags>seq-app</PackageTags>
        <PackageProjectUrl>https://github.com/rodion-andreev/Seq.App.GoogleChat</PackageProjectUrl>
        <RepositoryUrl>https://github.com/rodion-andreev/Seq.App.GoogleChat</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>googleChatIcon2023.png</PackageIcon>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Seq.Apps" Version="2023.4.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="../../asset/googleChatIcon2023.png" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
